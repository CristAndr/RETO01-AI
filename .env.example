# Proveedor del modelo: groq (por defecto) | ollama
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
# Solo si LLM_PROVIDER=groq. Se crea en https://console.groq.com/keys (nunca en el repo, el front ni los logs)
GROQ_API_KEY=
# Solo si LLM_PROVIDER=ollama (local)
OLLAMA_URL=http://localhost:11434
# Clave que protege /api/chat y /api/sessions (obligatoria; sin ella el servidor rechaza el chat)
ACCESS_KEY=
# Fecha contra la que se evalúan vigencias de soportes (AAAA-MM-DD). Vacía = hoy.
FECHA_EJECUCION=2026-09-25
# Topes de costo
MAX_ITER=25
MAX_TOKENS_SESION=150000
RATE_LIMIT_POR_MIN=10
LLM_TIMEOUT_MS=60000
PORT=3000

# --- Extensión HU-7: copia real del paquete por Gmail (opcional, fuera del PRD) ---
# Apagado salvo GMAIL_ENABLED=true. El refresh token se obtiene una vez con: npm run gmail-auth
GMAIL_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Cuenta que envía (la misma que autorizó)
GMAIL_FROM=
# Dominios permitidos separados por coma; vacío = cualquiera
EMAIL_DOMINIOS_PERMITIDOS=
CORREO_MAX_DIA=10
CORREO_MAX_SESION=3

# --- Inicio de sesión (HU-9) ---
# Secreto para firmar la cookie de sesión (32+ bytes). Obligatorio en producción; genéralo con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Orígenes permitidos para peticiones con cookie (CSRF), separados por coma. Vacío = localhost.
ORIGEN_PUBLICO=
